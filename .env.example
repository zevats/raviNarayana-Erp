# ==============================================================================
# Ravinarayan Management ERP - Environment Configuration Template
# PostgreSQL-Only Single Database Architecture
# ==============================================================================

# Application Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Database Configuration (PostgreSQL is the sole supported application database)
# Connection pooler URL (e.g., Supabase / Neon / PgBouncer port 6543 with pgbouncer=true)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct PostgreSQL connection for migrations and DDL operations (port 5432)
DIRECT_URL=postgres://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Note on Offline Tests:
# Test suites utilize an isolated test double adapter via ERP_DATABASE_PATH.
# The application runtime itself strictly requires PostgreSQL (DATABASE_URL).
# SQLite has been decommissioned as an application runtime option.

# Test Migration Destination Identity Guard (Phase 01B Safety)
# Strict hostname verification for migration scripts and rollback utilities
# Must exactly match the destination host (e.g., ep-xxxxxx.ap-southeast-1.aws.neon.tech)
EXPECTED_NEON_HOST=ep-example-123456.c-2.ap-southeast-1.aws.neon.tech
# Optional database name check (e.g., neondb)
EXPECTED_NEON_DATABASE=neondb
# Explicit opt-in flag required for live migration writes and destructive rollbacks
ALLOW_TEST_MIGRATION=false

# Transactional Email Configuration (Gmail SMTP)
# Used for 2FA Email OTP challenges and password recovery links
# Adapter options: 'smtp' (production/live) | 'mock' (local offline/test)
EMAIL_ADAPTER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zevats@gmail.com
# Google App Password generated for zevats@gmail.com (16 characters, 2-Step Verification required)
SMTP_APP_PASSWORD=your_16_char_google_app_password_here
EMAIL_FROM="Ravinarayan ERP <zevats@gmail.com>"
ERP_ADMIN_EMAIL=rishabh27kumar2006@gmail.com
ERP_APP_URL=http://localhost:3001

# Reverse Proxy & Client IP Trust Boundary
# Set to 'true' ONLY when running behind a verified reverse proxy (e.g., Nginx, Cloudflare)
# that sanitizes or provides trusted CF-Connecting-IP / X-Forwarded-For headers.
# Set to 'false' (default) for local development or direct socket connections to prevent IP spoofing.
TRUST_PROXY_HEADERS=false

# Initial Administrator Provisioning (Used ONLY on initial boot when staff_users table is empty)
# In production (NODE_ENV=production):
#   - ERP_ADMIN_PASSWORD is REQUIRED.
#   - Must be at least 12 characters.
#   - Known demo password ("Ravinarayan@2026") will cause startup to abort with a fatal error.
# Once staff users exist in the database, changing these environment variables has NO effect on existing credentials.
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_EMAIL=admin@ravinarayan.in
ERP_ADMIN_PASSWORD=Ravinarayan@2026
ERP_ADMIN_NAME="Ravinarayan Super Admin"

# Note on Session Architecture:
# Session tokens are 256-bit cryptographically random tokens (32 random bytes from OS CSPRNG).
# Only the SHA-256 one-way digest is stored in the database at rest.
# No shared server secret is required for opaque database-backed sessions.

# Host & Subdomain Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ERP_DOMAIN=erp.ravinarayan.in

# Optional: username of the DELIVERY_PERSON account that receives auto-assigned delivery orders.
# When unset, the longest-serving active delivery account is used.
# ERP_DEFAULT_DELIVERY_USERNAME=
