<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/rnGreen</item>
        <item name="android:navigationBarColor">@color/rnCream</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Keep the status and navigation bars separate from the page (Android 15 would draw the
             app edge-to-edge, putting the floating tab bar under the gesture bar). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Launch: the system splash is only the brand background; MainActivity then plays the opening
         animation (house for the ERP, rider for delivery) over the loading app. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rnSplash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">100</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/rnGreen</item>
    </style>

    <!-- Launch (splash): Delivery edition, used once a delivery partner has signed in on this phone -->
    <style name="AppTheme.NoActionBarLaunch.Delivery">
        <item name="windowSplashScreenBackground">@color/rnOrange</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:statusBarColor">@color/rnOrange</item>
    </style>
</resources>
