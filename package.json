    "test:task70": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_70_two_page_workflow.test.js",
    "test:task71": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_71_runtime_fixes_and_ux.test.js",
    "test:task73": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_73_migration_safety.test.js",
    "test:task74": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_74_local_admin_and_manifest.test.js",
