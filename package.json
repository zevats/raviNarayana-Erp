    "test:task63": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_63_financial_integrity_phase2.test.js",
    "test:task64": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_64_gstin_validation.test.js",
    "test:task66": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_66_mobile_pwa.test.js",
