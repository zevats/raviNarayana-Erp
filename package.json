{
  "name": "ravinarayan-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@ravinarayan/website",
    "dev:erp": "npm run dev --workspace=@ravinarayan/erp",
    "build:website": "npm run build --workspace=@ravinarayan/website",
    "build:erp": "npm run build --workspace=@ravinarayan/erp",
    "build": "npm run build:website && npm run build:erp",
    "start:website": "npm run start --workspace=@ravinarayan/website",
    "start:erp": "npm run start --workspace=@ravinarayan/erp",
    "lint:website": "npm run lint --workspace=@ravinarayan/website",
    "lint:erp": "npm run lint --workspace=@ravinarayan/erp",
    "lint": "npm run lint:website && npm run lint:erp",
    "test:security": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/auth_hardening.test.js",
    "test:rbac": "node -r ./tests/register_paths.js tests/dist/tests/rbac_staff_foundation.test.js",
    "test:rooms": "node -r ./tests/register_paths.js tests/dist/tests/rooms_residents.test.js",
    "test:finance": "node -r ./tests/register_paths.js tests/dist/tests/finance.test.js",
    "test:kitchen": "node -r ./tests/register_paths.js tests/dist/tests/kitchen.test.js",
    "test:integration": "node -r ./tests/register_paths.js tests/dist/tests/integration_audit.test.js",
    "test:delivery": "node -r ./tests/register_paths.js tests/dist/tests/delivery.test.js",
    "test": "npm run test:security && npm run test:rbac && npm run test:rooms && npm run test:finance && npm run test:kitchen && npm run test:integration && npm run test:delivery",
    "seed:demo": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/seed_synthetic_data.js --allow-synthetic-seed"
  }
}
