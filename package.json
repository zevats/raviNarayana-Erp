{
  "name": "ravinarayan-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@ravinarayan/website",
    "dev:erp": "npm run dev --workspace=@ravinarayan/erp",
    "dev:erp:local": "npm run dev:local --workspace=@ravinarayan/erp",
    "build:website": "npm run build --workspace=@ravinarayan/website",
    "build:erp": "npm run build --workspace=@ravinarayan/erp",
    "build": "npm run build:website && npm run build:erp",
    "start:website": "npm run start --workspace=@ravinarayan/website",
    "start:erp": "npm run start --workspace=@ravinarayan/erp",
    "lint:website": "npm run lint --workspace=@ravinarayan/website",
    "lint:erp": "npm run lint --workspace=@ravinarayan/erp",
    "lint": "npm run lint:website && npm run lint:erp",
    "db:migrate": "node scripts/migrate.js",
    "db:local": "powershell -File scripts/local-db.ps1",
    "db:migrate:local": "powershell -File scripts/local-db.ps1 -Action migrate",
    "db:seed:local": "node -r ./tests/register_paths.js scripts/seed-local-admin.js",
    "test:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-sandboxed-tests.ps1",
    "test:security": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/auth_hardening.test.js",
    "test:rbac": "node -r ./tests/register_paths.js tests/dist/tests/rbac_staff_foundation.test.js",
    "test:rooms": "node -r ./tests/register_paths.js tests/dist/tests/rooms_residents.test.js",
    "test:finance": "node -r ./tests/register_paths.js tests/dist/tests/finance.test.js",
    "test:invoicing": "node -r ./tests/register_paths.js tests/dist/tests/invoicing.test.js",
    "test:kitchen": "node -r ./tests/register_paths.js tests/dist/tests/kitchen.test.js",
    "test:integration": "node -r ./tests/register_paths.js tests/dist/tests/integration_audit.test.js",
    "test:delivery": "node -r ./tests/register_paths.js tests/dist/tests/delivery.test.js",
    "test:otp": "node -r ./tests/register_paths.js tests/dist/tests/otp_auth_flow.test.js",
    "test:perf": "node -r ./tests/register_paths.js tests/dist/tests/performance_and_caching.test.js",
    "test:tiffin": "node -r ./tests/register_paths.js tests/dist/tests/tiffin.test.js",
    "test:kitchen_inventory": "node -r ./tests/register_paths.js tests/dist/tests/kitchen_inventory.test.js",
    "test:task50": "node -r ./tests/register_paths.js tests/dist/tests/task01b_50_remediation.test.js",
    "test:task51": "node -r ./tests/register_paths.js tests/dist/tests/task01b_51_remediation.test.js",
    "test:task52": "node -r ./tests/register_paths.js tests/dist/tests/task01b_52_settlement.test.js",
    "test:task53": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_53_closing.test.js",
    "test:task54": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_54_rooms.test.js",
    "test:task55": "npx tsc -p tests/tsconfig.json && node -r ./tests/register_paths.js tests/dist/tests/task01b_55_reporting.test.js",
