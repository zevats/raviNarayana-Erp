# Ravi Narayana ERP - Local Development Environment Template
# Copy to apps/erp/.env.local for local offline development.
# Do NOT place production or rehearsal cloud credentials in this file.

# Isolated Local PostgreSQL Database URL (127.0.0.1:5432)
DATABASE_URL=postgresql://erp_local_user:erp_local_password@127.0.0.1:5432/ravinarayana_erp_local
DIRECT_URL=postgresql://erp_local_user:erp_local_password@127.0.0.1:5432/ravinarayana_erp_local

# Security & Session Secrets (Development Values)
SESSION_SECRET=local-development-session-secret-change-if-needed-32chars
JWT_SECRET=local-development-jwt-secret-minimum-32-chars-long
NEXTAUTH_SECRET=local-development-nextauth-secret-key-32chars
NEXTAUTH_URL=http://localhost:3001

# Application Ports
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Business Context Defaults
DEFAULT_BUSINESS_CONTEXT=PG
